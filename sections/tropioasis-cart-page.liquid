<style>
.tropi-cart-page{
  width:100vw;
  margin-left:calc(50% - 50vw);
  margin-right:calc(50% - 50vw);
  background:#f8f4ea;
  min-height:100vh;
  padding:80px 6vw 100px;
  position:relative;
  overflow:hidden;
  font-family:'Nunito',sans-serif;
}

.tropi-cart-page::before{
  content:"";
  position:absolute;
  top:-120px;
  left:-120px;
  width:260px;
  height:260px;
  border-radius:50%;
  background:rgba(255,214,10,.25);
}

.tropi-cart-header{
  text-align:center;
  margin-bottom:60px;
  position:relative;
  z-index:2;
}

.tropi-cart-badge{
  display:inline-flex;
  padding:12px 28px;
  border-radius:999px;
  border:2px solid #ff006e;
  font-size:13px;
  font-weight:900;
  text-transform:uppercase;
  color:#111827;
  background:#fffaf5;
  margin-bottom:20px;
}

.tropi-cart-title{
  font-size:86px;
  line-height:.9;
  font-weight:900;
  margin:0;
  color:#08a9c3;
  text-shadow:0 8px 0 rgba(0,0,0,.08);
}

.tropi-cart-subtitle{
  margin-top:18px;
  font-size:18px;
  font-weight:800;
  color:#0f172a;
}

.tropi-cart-layout{
  max-width:1400px;
  margin:0 auto;
  display:grid;
  grid-template-columns:1fr 360px;
  gap:34px;
  align-items:start;
}

.cart-items{
  display:flex;
  flex-direction:column;
  gap:24px;
}

.cart-item{
  background:#fff;
  border-radius:34px;
  padding:18px;
  display:grid;
  grid-template-columns:170px 1fr;
  gap:24px;
  align-items:center;
  box-shadow:0 18px 42px rgba(0,0,0,.08);
}

.cart-image{
  border-radius:28px;
  overflow:hidden;
  background:#f3f4f6;
}

.cart-image img{
  width:100%;
  display:block;
}

.cart-info{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.cart-title{
  font-size:24px;
  font-weight:900;
  color:#0f172a;
  text-decoration:none;
}

.cart-size{
  font-size:14px;
  font-weight:900;
  color:#6b7280;
  text-transform:uppercase;
}

.cart-item-properties{
  margin-top:8px;
  padding:14px 16px;
  border-radius:18px;
  background:#fff7fb;
  border:1px solid rgba(255,0,110,.12);
  display:grid;
  gap:8px;
  max-width:620px;
}

.custom-order-title{
  color:#ff006e;
  font-size:13px;
  font-weight:900;
  text-transform:uppercase;
}

.cart-property-line{
  display:grid;
  gap:3px;
}

.cart-property-line span{
  color:#0f172a;
  font-size:13px;
  font-weight:900;
  text-transform:uppercase;
}

.cart-property-line strong{
  color:#475569;
  font-size:14px;
  line-height:1.35;
  font-weight:800;
}

.cart-price{
  font-size:24px;
  font-weight:900;
  color:#ff6b00;
}

.cart-bottom{
  margin-top:8px;
  display:flex;
  align-items:center;
  gap:18px;
  flex-wrap:wrap;
}

.qty-control{
  width:170px !important;
  height:52px;
  display:grid !important;
  grid-template-columns:48px 1fr 48px !important;
  align-items:center;
  border-radius:999px;
  overflow:hidden;
  background:#fff;
  border:1px solid rgba(0,0,0,.08);
}

.qty-control button{
  width:48px;
  height:52px;
  border:none;
  background:#fff;
  font-size:28px;
  font-weight:900;
  cursor:pointer;
  color:#ff006e;
  display:flex;
  align-items:center;
  justify-content:center;
}

.qty-control button:hover{
  background:#fff1f6;
}

.qty-control input{
  width:100%;
  height:52px;
  border:none;
  text-align:center;
  font-size:18px;
  font-weight:900;
  color:#0f172a;
  outline:none;
  background:transparent;
  appearance:none;
  -webkit-appearance:none;
  margin:0;
  padding:0;
}

.qty-control input::-webkit-outer-spin-button,
.qty-control input::-webkit-inner-spin-button{
  -webkit-appearance:none;
  margin:0;
}

.cart-remove{
  border:0;
  background:transparent;
  font-size:14px;
  font-weight:900;
  color:#ff006e;
  text-transform:uppercase;
  text-decoration:underline;
  cursor:pointer;
  font-family:'Nunito',sans-serif;
}

.cart-summary{
  background:#fff;
  border-radius:34px;
  padding:30px;
  position:sticky;
  top:125px;
  box-shadow:0 18px 42px rgba(0,0,0,.08);
}

.summary-label{
  font-size:14px;
  font-weight:900;
  text-transform:uppercase;
  color:#ff006e;
  margin-bottom:20px;
}

.summary-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:18px;
}

.summary-title{
  font-size:20px;
  font-weight:900;
  color:#0f172a;
}

.summary-price{
  font-size:28px;
  font-weight:900;
  color:#ff6b00;
}

.summary-note{
  font-size:14px;
  line-height:1.5;
  color:#475569;
  margin-bottom:28px;
  font-weight:800;
}

.checkout-btn{
  width:100%;
  height:60px;
  border:none;
  border-radius:999px;
  font-size:18px;
  font-weight:900;
  text-transform:uppercase;
  color:#fff;
  cursor:pointer;
  background:linear-gradient(90deg,#ff006e,#ff5e00,#08a9c3);
  box-shadow:0 14px 25px rgba(255,0,110,.25);
}

.continue-shopping{
  margin-top:18px;
  display:block;
  text-align:center;
  font-size:14px;
  font-weight:900;
  text-transform:uppercase;
  color:#0f172a;
}

.empty-cart{
  text-align:center;
  padding:100px 20px;
}

.empty-cart h2{
  font-size:42px;
  margin-bottom:14px;
  color:#08a9c3;
}

.empty-cart p{
  font-size:18px;
  color:#475569;
  margin-bottom:28px;
}

.shop-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:18px 34px;
  border-radius:999px;
  background:linear-gradient(90deg,#ff006e,#ff5e00,#08a9c3);
  color:#fff;
  font-weight:900;
  text-decoration:none;
}

@media(max-width:990px){
  .tropi-cart-title{
    font-size:60px;
  }

  .tropi-cart-layout{
    grid-template-columns:1fr;
  }

  .cart-summary{
    position:relative;
    top:0;
  }
}

@media(max-width:640px){
  .cart-item{
    grid-template-columns:1fr;
  }

  .cart-image{
    max-width:260px;
  }

  .cart-bottom{
    flex-direction:column;
    align-items:flex-start;
  }

  .qty-control{
    width:100% !important;
  }
}
</style>

<div class="tropi-cart-page">

  <div class="tropi-cart-header">

    <div class="tropi-cart-badge">
      Tu compra TropiOasis
    </div>

    <h1 class="tropi-cart-title">
      Carrito
    </h1>

    <p class="tropi-cart-subtitle">
      Revisa tus jugos, shots y kits antes de finalizar tu orden.
    </p>

  </div>

  {% if cart.item_count > 0 %}

    <form action="{{ routes.cart_url }}" method="post" novalidate id="cart-form">

      <div class="tropi-cart-layout">

        <div class="cart-items">

          {% for item in cart.items %}

            <div class="cart-item">

              <div class="cart-image">

                <a href="{{ item.url }}">

                  {% if item.image %}

                    <img
                      src="{{ item.image | image_url: width: 500 }}"
                      alt="{{ item.title }}"
                      loading="lazy"
                    >

                  {% endif %}

                </a>

              </div>

              <div class="cart-info">

                <a href="{{ item.url }}" class="cart-title">
                  {{ item.product.title }}
                </a>

                {% if item.variant.title != 'Default Title' %}

                  <div class="cart-size">
                    {{ item.variant.title }}
                  </div>

                {% else %}

                  <div class="cart-size">

                    {% if item.product.title contains '25oz' %}
                      25oz

                    {% elsif item.product.title contains '32oz' %}
                      32oz

                    {% elsif item.product.title contains '4 x 8oz' or item.product.title contains '4x8oz' %}
                      4 x 8oz

                    {% elsif item.product.title contains '7 x 2oz' or item.product.title contains '7x2oz' %}
                      7 x 2oz

                    {% elsif item.product.title contains '200ml' %}
                      200ml

                    {% elsif item.product.title contains 'Shot' %}
                      2oz

                    {% else %}
                      8oz
                    {% endif %}

                  </div>

                {% endif %}

                {% assign has_properties = false %}

                {% for property in item.properties %}
                  {% assign first_character = property.first | slice: 0 %}

                  {% if property.last != blank and first_character != '_' %}
                    {% assign has_properties = true %}
                  {% endif %}
                {% endfor %}

                {% if has_properties %}

                  <div class="cart-item-properties">

                    <div class="custom-order-title">
                      Tu mezcla personalizada
                    </div>

                    {% for property in item.properties %}

                      {% assign first_character = property.first | slice: 0 %}

                      {% if property.last != blank and first_character != '_' %}

                        <div class="cart-property-line">

                          <span>
                            {{ property.first }}
                          </span>

                          <strong>
                            {{ property.last }}
                          </strong>

                        </div>

                      {% endif %}

                    {% endfor %}

                  </div>

                {% endif %}

                <div class="cart-price">
                  {{ item.final_line_price | money }}
                </div>

                <div class="cart-bottom">

                  <div class="qty-control">

                    <button type="button" class="qty-minus">
                      −
                    </button>

                    <input
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="1"
                      data-line="{{ forloop.index }}"
                    >

                    <button type="button" class="qty-plus">
                      +
                    </button>

                  </div>

                  <button
                    type="button"
                    class="cart-remove remove-item-btn"
                    data-line="{{ forloop.index }}"
                  >
                    Remove
                  </button>

                </div>

              </div>

            </div>

          {% endfor %}

        </div>

        <div class="cart-summary">

          <div class="summary-label">
            Resumen
          </div>

          <div class="summary-row">

            <div class="summary-title">
              Subtotal
            </div>

            <div class="summary-price">
              {{ cart.total_price | money }}
            </div>

          </div>

          <div class="summary-note">
            Taxes, envío y descuentos se calculan en checkout.
          </div>

          <button
            class="checkout-btn"
            type="submit"
            name="checkout"
          >
            Checkout
          </button>

          <a href="/collections/all" class="continue-shopping">
            Seguir comprando
          </a>

        </div>

      </div>

    </form>

  {% else %}

    <div class="empty-cart">

      <h2>
        Tu carrito está vacío
      </h2>

      <p>
        Descubre nuestros functional juices y wellness shots.
      </p>

      <a href="/collections/all" class="shop-btn">
        Comprar ahora
      </a>

    </div>

  {% endif %}

</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

  function updateCart(line, quantity) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        line: Number(line),
        quantity: Number(quantity)
      })
    })
    .then(function(response) {
      return response.json();
    })
    .then(function() {
      location.reload();
    });
  }

  document.querySelectorAll('.qty-control').forEach(function(control) {
    const input = control.querySelector('input');
    const minus = control.querySelector('.qty-minus');
    const plus = control.querySelector('.qty-plus');

    minus.addEventListener('click', function() {
      let value = parseInt(input.value || '1', 10);
      value = Math.max(1, value - 1);
      input.value = value;
      updateCart(input.dataset.line, value);
    });

    plus.addEventListener('click', function() {
      let value = parseInt(input.value || '1', 10);
      value = value + 1;
      input.value = value;
      updateCart(input.dataset.line, value);
    });

    input.addEventListener('change', function() {
      let value = parseInt(input.value || '1', 10);
      value = Math.max(1, value);
      input.value = value;
      updateCart(input.dataset.line, value);
    });
  });

  document.querySelectorAll('.remove-item-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      updateCart(btn.dataset.line, 0);
    });
  });

});
</script>

{% schema %}
{
  "name": "TropiOasis Cart Page",
  "settings": [],
  "presets": [
    {
      "name": "TropiOasis Cart Page"
    }
  ]
}
{% endschema %}