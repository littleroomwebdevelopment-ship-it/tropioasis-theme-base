<section id="faq" class="tropi-faq-section">

  <div class="faq-orb faq-orb-one"></div>
  <div class="faq-orb faq-orb-two"></div>

  <div class="faq-header">

    <span class="faq-kicker">
      TropiOasis Support
    </span>

    <h2>
      Frequently Asked
      <strong>Questions</strong>
    </h2>

    <p>
      Todo lo que necesitas saber sobre nuestros jugos,
      wellness shots, órdenes y delivery.
    </p>

  </div>

  <div class="faq-wrapper">

    <div class="faq-item active">

      <button class="faq-question">

        <span>
          ¿Los jugos son frescos?
        </span>

        <div class="faq-icon">
          +
        </div>

      </button>

      <div class="faq-answer">

        <p>
          Sí. Todos nuestros jugos y wellness shots se preparan frescos
          diariamente utilizando ingredientes naturales y cold pressed.
        </p>

      </div>

    </div>

    <div class="faq-item">

      <button class="faq-question">

        <span>
          ¿Puedo crear mi propia mezcla?
        </span>

        <div class="faq-icon">
          +
        </div>

      </button>

      <div class="faq-answer">

        <p>
          Claro. En nuestro Juice Bar puedes escoger entre más de 20 ingredientes
          y crear un jugo completamente personalizado.
        </p>

      </div>

    </div>

    <div class="faq-item">

      <button class="faq-question">

        <span>
          ¿Hacen delivery en Puerto Rico?
        </span>

        <div class="faq-icon">
          +
        </div>

      </button>

      <div class="faq-answer">

        <p>
          Sí. Ofrecemos entrega rápida en Puerto Rico dependiendo
          tu ubicación y disponibilidad.
        </p>

      </div>

    </div>

    <div class="faq-item">

      <button class="faq-question">

        <span>
          ¿Cuánto duran los jugos refrigerados?
        </span>

        <div class="faq-icon">
          +
        </div>

      </button>

      <div class="faq-answer">

        <p>
          Recomendamos consumirlos dentro de 2 a 4 días
          manteniéndolos refrigerados para conservar su frescura.
        </p>

      </div>

    </div>

    <div class="faq-item">

      <button class="faq-question">

        <span>
          ¿Qué métodos de pago aceptan?
        </span>

        <div class="faq-icon">
          +
        </div>

      </button>

      <div class="faq-answer">

        <p>
          Aceptamos tarjetas de crédito/débito,
          Shop Pay, Apple Pay y otros métodos seguros integrados en Shopify.
        </p>

      </div>

    </div>

  </div>

</section>

<style>

.tropi-faq-section{
  width:100vw;
  margin-left:calc(50% - 50vw);
  margin-right:calc(50% - 50vw);
  padding:110px 6vw;
  position:relative;
  overflow:hidden;
  background:
    radial-gradient(circle at 0% 0%, rgba(255,208,0,.24) 0 240px, transparent 250px),
    radial-gradient(circle at 100% 100%, rgba(255,208,0,.10) 0 260px, transparent 270px),
    linear-gradient(135deg,#fffaf0 0%,#fff7ea 55%,#fffdf6 100%);
  font-family:'Nunito',sans-serif;
}

.faq-orb{
  position:absolute;
  border-radius:50%;
  filter:blur(2px);
  opacity:.5;
  pointer-events:none;
}

.faq-orb-one{
  width:210px;
  height:210px;
  background:#ffd000;
  top:-60px;
  left:-60px;
}

.faq-orb-two{
  width:180px;
  height:180px;
  background:#ffd000;
  right:-50px;
  bottom:120px;
  opacity:.18;
}

.faq-header{
  position:relative;
  z-index:2;
  max-width:900px;
  margin:0 auto 60px;
  text-align:center;
}

.faq-kicker{
  display:inline-block;
  padding:11px 24px;
  border-radius:999px;
  border:2px solid #ec0057;
  background:rgba(255,255,255,.8);
  color:#07112f;
  font-size:13px;
  font-weight:900;
  text-transform:uppercase;
  margin-bottom:20px;
}

.faq-header h2{
  margin:0;
  font-size:clamp(58px,6vw,110px);
  line-height:.9;
  font-weight:900;
  color:#ff4f8c;
  letter-spacing:-4px;
  text-shadow:0 9px 0 rgba(255,79,140,.12);
}

.faq-header h2 strong{
  display:block;
  color:#ff8a1f;
}

.faq-header p{
  max-width:720px;
  margin:22px auto 0;
  color:#07112f;
  font-size:21px;
  line-height:1.4;
  font-weight:800;
}

.faq-wrapper{
  position:relative;
  z-index:2;
  max-width:1000px;
  margin:0 auto;
  display:grid;
  gap:20px;
}

.faq-item{
  background:rgba(255,255,255,.9);
  border-radius:30px;
  overflow:hidden;
  border:1px solid rgba(0,0,0,.05);
  box-shadow:0 18px 44px rgba(0,0,0,.08);
  transition:.25s ease;
}

.faq-item.active{
  box-shadow:0 26px 60px rgba(0,0,0,.12);
}

.faq-question{
  width:100%;
  border:none;
  background:transparent;
  padding:28px 30px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  cursor:pointer;
  text-align:left;
}

.faq-question span{
  color:#07112f;
  font-size:22px;
  line-height:1.2;
  font-weight:900;
}

.faq-icon{
  width:52px;
  height:52px;
  border-radius:50%;
  background:linear-gradient(
    135deg,
    #ffd000,
    #ffb800,
    #ff9a00
  );
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:28px;
  font-weight:900;
  flex-shrink:0;
  transition:.25s ease;
}

.faq-item.active .faq-icon{
  transform:rotate(45deg);
}

.faq-answer{
  max-height:0;
  overflow:hidden;
  transition:max-height .35s ease;
}

.faq-item.active .faq-answer{
  max-height:300px;
}

.faq-answer p{
  margin:0;
  padding:0 30px 30px;
  color:#4c5360;
  font-size:17px;
  line-height:1.6;
  font-weight:800;
}

@media(max-width:700px){

  .tropi-faq-section{
    padding:80px 20px;
  }

  .faq-header h2{
    font-size:58px;
    letter-spacing:-2px;
  }

  .faq-header p{
    font-size:18px;
  }

  .faq-question{
    padding:24px 22px;
  }

  .faq-question span{
    font-size:18px;
  }

  .faq-answer p{
    padding:0 22px 24px;
    font-size:15px;
  }

}

</style>

<script>

document.addEventListener('DOMContentLoaded', function(){

  const faqItems =
    document.querySelectorAll('.faq-item');

  faqItems.forEach(function(item){

    const button =
      item.querySelector('.faq-question');

    button.addEventListener('click', function(){

      const isActive =
        item.classList.contains('active');

      faqItems.forEach(function(el){

        el.classList.remove('active');

      });

      if(!isActive){

        item.classList.add('active');

      }

    });

  });

});

</script>

{% schema %}
{
  "name": "TropiOasis FAQ",
  "settings": [],
  "presets": [
    {
      "name": "TropiOasis FAQ"
    }
  ]
}
{% endschema %}