<section id="faq" class="tropi-faq-section">

  <div class="faq-orb faq-orb-one"></div>
  <div class="faq-orb faq-orb-two"></div>

  <div class="faq-header">
    <span class="faq-kicker">
      TropiOasis Support
    </span>

    <h2>
      Preguntas 
      <strong>Frecuentes</strong>
    </h2>

    <p>
      Todo lo que necesitas saber sobre nuestros jugos,
      wellness shots, órdenes y delivery.
    </p>
  </div>

  <div class="faq-wrapper">

    <div class="faq-item active">
      <button class="faq-question" type="button" aria-expanded="true">
        <span>¿Qué es TropiOasis?</span>
        <div class="faq-icon">+</div>
      </button>

      <div class="faq-answer">
        <p>
          TropiOasis es una marca puertorriqueña de jugos cold-pressed y wellness shots elaborados con frutas y vegetales frescos. Nuestros productos no contienen azúcar añadida, colorantes ni preservativos.
        </p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">
        <span>¿Qué significa "Cold-Pressed"?</span>
        <div class="faq-icon">+</div>
      </button>

      <div class="faq-answer">
        <p>
          Es un método de extracción que utiliza presión en lugar de calor para ayudar a conservar mejor los nutrientes y el sabor natural de los ingredientes.
        </p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">
        <span>¿Sus productos contienen azúcar añadida?</span>
        <div class="faq-icon">+</div>
      </button>

      <div class="faq-answer">
        <p>
          No. El dulzor proviene de las frutas utilizadas en cada receta y syrup de agave de ser solicitado.
        </p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">
        <span>¿Cómo se consumen los productos?</span>
        <div class="faq-icon">+</div>
      </button>

      <div class="faq-answer">
        <p>
          Los jugos de 8 oz pueden disfrutarse completos o dividirse en dos porciones durante el día. Los wellness shots de 2 oz están diseñados para consumirse completos en una sola toma. Todos los productos deben mantenerse refrigerados.
        </p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">
        <span>¿Cuánto tiempo duran los jugos?</span>
        <div class="faq-icon">+</div>
      </button>

      <div class="faq-answer">
        <p>
          Recomendamos consumirlos dentro de los 4 a 6 días posteriores a la entrega y mantenerlos siempre refrigerados.
        </p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">
        <span>¿Necesito hacer un detox para consumir sus jugos?</span>
        <div class="faq-icon">+</div>
      </button>

      <div class="faq-answer">
        <p>
          No. Nuestros jugos pueden formar parte de tu rutina diaria y complementar una alimentación balanceada y un estilo de vida saludable.
        </p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">
        <span>¿Realizan entregas?</span>
        <div class="faq-icon">+</div>
      </button>

      <div class="faq-answer">
        <p>
          Sí. Ofrecemos entregas en distintas áreas de Puerto Rico y también coordinamos puntos de encuentro según la ruta disponible.
        </p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">
        <span>¿Puedo ordenar para eventos o actividades?</span>
        <div class="faq-icon">+</div>
      </button>

      <div class="faq-answer">
        <p>
          Sí. Podemos preparar órdenes para actividades corporativas, eventos privados, ferias, mercados y celebraciones especiales.
        </p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">
        <span>¿Cómo hago mi pedido?</span>
        <div class="faq-icon">+</div>
      </button>

      <div class="faq-answer">
        <p>
          Puedes realizar tu pedido a través de nuestra página web, WhatsApp o redes sociales.
        </p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button" aria-expanded="false">
        <span>¿Debo agitar el jugo antes de consumirlo?</span>
        <div class="faq-icon">+</div>
      </button>

      <div class="faq-answer">
        <p>
          Sí. Es normal que los ingredientes naturales se separen con el tiempo. Agítalo bien antes de disfrutarlo.
        </p>
      </div>
    </div>

  </div>

</section>

<style>
  .tropi-faq-section {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 110px 6vw;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 0% 0%, rgba(255,208,0,.24) 0 240px, transparent 250px),
      radial-gradient(circle at 100% 100%, rgba(255,208,0,.10) 0 260px, transparent 270px),
      linear-gradient(135deg,#fffaf0 0%,#fff7ea 55%,#fffdf6 100%);
    font-family: 'Nunito', sans-serif;
    box-sizing: border-box;
  }

  .faq-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: .5;
    pointer-events: none;
  }

  .faq-orb-one {
    width: 210px;
    height: 210px;
    background: #ffd000;
    top: -60px;
    left: -60px;
  }

  .faq-orb-two {
    width: 180px;
    height: 180px;
    background: #ffd000;
    right: -50px;
    bottom: 120px;
    opacity: .18;
  }

  .faq-header {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto 60px;
    text-align: center;
  }

  .faq-kicker {
    display: inline-block;
    padding: 11px 24px;
    border-radius: 999px;
    border: 2px solid #ec0057;
    background: rgba(255,255,255,.8);
    color: #07112f;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .faq-header h2 {
    margin: 0;
    font-size: clamp(58px,6vw,110px);
    line-height: .9;
    font-weight: 900;
    color: #ff4f8c;
    letter-spacing: -4px;
    text-shadow: 0 9px 0 rgba(255,79,140,.12);
  }

  .faq-header h2 strong {
    display: block;
    color: #ff8a1f;
  }

  .faq-header p {
    max-width: 720px;
    margin: 22px auto 0;
    color: #07112f;
    font-size: 21px;
    line-height: 1.4;
    font-weight: 800;
  }

  .faq-wrapper {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    gap: 20px;
  }

  .faq-item {
    background: rgba(255,255,255,.9);
    border-radius: 30px;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,.05);
    box-shadow: 0 18px 44px rgba(0,0,0,.08);
    transition: .25s ease;
  }

  .faq-item.active {
    box-shadow: 0 26px 60px rgba(0,0,0,.12);
  }

  .faq-question {
    width: 100%;
    border: none;
    background: transparent;
    padding: 28px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    text-align: left;
    font-family: 'Nunito', sans-serif;
  }

  .faq-question span {
    color: #07112f;
    font-size: 22px;
    line-height: 1.2;
    font-weight: 900;
  }

  .faq-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      #ffd000,
      #ffb800,
      #ff9a00
    );
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: 900;
    flex-shrink: 0;
    transition: .25s ease;
  }

  .faq-item.active .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height .35s ease;
  }

  .faq-item.active .faq-answer {
    max-height: 420px;
  }

  .faq-answer p {
    margin: 0;
    padding: 0 30px 30px;
    color: #4c5360;
    font-size: 17px;
    line-height: 1.6;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .tropi-faq-section {
      padding: 90px 28px;
    }

    .faq-header {
      margin-bottom: 46px;
    }

    .faq-header h2 {
      font-size: clamp(56px, 10vw, 78px);
      letter-spacing: -3px;
    }

    .faq-header p {
      font-size: 19px;
    }
  }

  @media (max-width: 700px) {
    .tropi-faq-section {
      padding: 76px 20px;
    }

    .faq-header h2 {
      font-size: clamp(44px, 13vw, 58px);
      letter-spacing: -2px;
    }

    .faq-header p {
      font-size: 18px;
    }

    .faq-wrapper {
      gap: 16px;
    }

    .faq-item {
      border-radius: 24px;
    }

    .faq-question {
      padding: 24px 22px;
    }

    .faq-question span {
      font-size: 18px;
    }

    .faq-icon {
      width: 44px;
      height: 44px;
      font-size: 25px;
    }

    .faq-answer p {
      padding: 0 22px 24px;
      font-size: 15px;
    }
  }

  @media (max-width: 480px) {
    .tropi-faq-section {
      padding: 64px 14px;
    }

    .faq-kicker {
      width: 100%;
      box-sizing: border-box;
      padding: 10px 16px;
      font-size: 11px;
    }

    .faq-header {
      margin-bottom: 36px;
    }

    .faq-header h2 {
      font-size: 40px;
      letter-spacing: -1.4px;
    }

    .faq-header p {
      font-size: 16px;
    }

    .faq-question {
      padding: 20px 18px;
      gap: 14px;
    }

    .faq-question span {
      font-size: 16px;
    }

    .faq-icon {
      width: 38px;
      height: 38px;
      font-size: 22px;
    }

    .faq-answer p {
      padding: 0 18px 22px;
      font-size: 14px;
      line-height: 1.55;
    }
  }

  @media (max-width: 380px) {
    .faq-header h2 {
      font-size: 36px;
    }

    .faq-question span {
      font-size: 15px;
    }

    .faq-icon {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(function (item) {
      const button = item.querySelector('.faq-question');

      button?.addEventListener('click', function () {
        const isActive = item.classList.contains('active');

        faqItems.forEach(function (el) {
          el.classList.remove('active');

          const elButton = el.querySelector('.faq-question');

          if (elButton) {
            elButton.setAttribute('aria-expanded', 'false');
          }
        });

        if (!isActive) {
          item.classList.add('active');
          button.setAttribute('aria-expanded', 'true');
        } else {
          button.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "TropiOasis FAQ",
  "settings": [],
  "presets": [
    {
      "name": "TropiOasis FAQ"
    }
  ]
}
{% endschema %}