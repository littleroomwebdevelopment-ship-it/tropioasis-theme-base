</section>

<style>
  .tropi-faq-page {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 115px 6vw 130px;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 0% 0%, rgba(255,208,0,.24) 0 240px, transparent 250px),
      radial-gradient(circle at 100% 10%, rgba(236,0,87,.12) 0 260px, transparent 275px),
      radial-gradient(circle at 100% 100%, rgba(0,167,183,.12) 0 280px, transparent 295px),
      linear-gradient(135deg,#fffaf0 0%,#fff7ea 55%,#ecfff4 100%);
    font-family: 'Nunito', sans-serif;
    box-sizing: border-box;
  }

  .faq-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: .5;
    pointer-events: none;
  }

  .faq-orb-one {
    width: 210px;
    height: 210px;
    background: #ffd000;
    top: -60px;
    left: -60px;
  }

  .faq-orb-two {
    width: 180px;
    height: 180px;
    background: #00a7b7;
    right: -50px;
    bottom: 120px;
    opacity: .16;
  }

  .faq-page-header {
    position: relative;
    z-index: 2;
    max-width: 980px;
    margin: 0 auto 65px;
    text-align: center;
  }

  .faq-kicker {
    display: inline-block;
    padding: 11px 24px;
    border-radius: 999px;
    border: 2px solid #ec0057;
    background: rgba(255,255,255,.82);
    color: #07112f;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 22px;
    box-shadow: 0 14px 30px rgba(236,0,87,.12);
  }

  .faq-page-header h1 {
    margin: 0;
    font-size: clamp(58px,7vw,118px);
    line-height: .88;
    font-weight: 900;
    color: #ff4f8c;
    letter-spacing: -4px;
    text-transform: uppercase;
    text-shadow: 0 9px 0 rgba(255,79,140,.12);
  }

  .faq-page-header h1 strong {
    display: block;
    color: #ff8a1f;
  }

  .faq-page-header p {
    max-width: 790px;
    margin: 24px auto 0;
    color: #07112f;
    font-size: 21px;
    line-height: 1.45;
    font-weight: 800;
  }

  .faq-page-wrapper {
    position: relative;
    z-index: 2;
    max-width: 1050px;
    margin: 0 auto;
    display: grid;
    gap: 18px;
  }

  .faq-category {
    margin: 42px 0 4px;
    color: #00a7b7;
    font-size: 32px;
    line-height: 1;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -1px;
  }

  .faq-category:first-child {
    margin-top: 0;
  }

  .faq-item {
    background: rgba(255,255,255,.92);
    border-radius: 30px;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,.05);
    box-shadow: 0 18px 44px rgba(0,0,0,.08);
    transition: .25s ease;
  }

  .faq-item.active {
    box-shadow: 0 26px 60px rgba(0,0,0,.12);
  }

  .faq-question {
    width: 100%;
    border: none;
    background: transparent;
    padding: 27px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    text-align: left;
    font-family: 'Nunito', sans-serif;
  }

  .faq-question span {
    color: #07112f;
    font-size: 21px;
    line-height: 1.25;
    font-weight: 900;
  }

  .faq-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg,#ffd000,#ffb800,#ff9a00);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: 900;
    flex-shrink: 0;
    transition: .25s ease;
    box-shadow: 0 12px 24px rgba(255,154,0,.22);
  }

  .faq-item.active .faq-icon {
    transform: rotate(45deg);
    background: linear-gradient(135deg,#ec0057,#ff4f8c,#ff8a1f);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height .35s ease;
  }

  .faq-item.active .faq-answer {
    max-height: 620px;
  }

  .faq-answer p {
    margin: 0;
    padding: 0 30px 30px;
    color: #4c5360;
    font-size: 17px;
    line-height: 1.65;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .tropi-faq-page {
      padding: 94px 28px 110px;
    }

    .faq-page-header {
      margin-bottom: 50px;
    }

    .faq-page-header h1 {
      font-size: clamp(54px, 11vw, 78px);
      letter-spacing: -3px;
    }

    .faq-page-header p {
      font-size: 19px;
    }
  }

  @media (max-width: 700px) {
    .tropi-faq-page {
      padding: 82px 20px 95px;
    }

    .faq-kicker {
      font-size: 12px;
      padding: 10px 18px;
    }

    .faq-page-header h1 {
      font-size: clamp(44px, 13vw, 56px);
      letter-spacing: -2px;
    }

    .faq-page-header p {
      font-size: 18px;
    }

    .faq-category {
      font-size: 25px;
      line-height: 1.1;
    }

    .faq-question {
      padding: 24px 22px;
    }

    .faq-question span {
      font-size: 18px;
    }

    .faq-icon {
      width: 44px;
      height: 44px;
      font-size: 24px;
    }

    .faq-answer p {
      padding: 0 22px 24px;
      font-size: 15px;
    }
  }

  @media (max-width: 480px) {
    .tropi-faq-page {
      padding: 68px 14px 82px;
    }

    .faq-kicker {
      width: 100%;
      box-sizing: border-box;
      font-size: 11px;
      text-align: center;
    }

    .faq-page-header {
      margin-bottom: 38px;
    }

    .faq-page-header h1 {
      font-size: 38px;
      letter-spacing: -1.5px;
    }

    .faq-page-header p {
      font-size: 16px;
    }

    .faq-category {
      font-size: 21px;
      margin: 34px 0 2px;
    }

    .faq-item {
      border-radius: 24px;
    }

    .faq-question {
      padding: 20px 18px;
      gap: 14px;
    }

    .faq-question span {
      font-size: 16px;
    }

    .faq-icon {
      width: 38px;
      height: 38px;
      font-size: 22px;
    }

    .faq-answer p {
      padding: 0 18px 22px;
      font-size: 14px;
      line-height: 1.55;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const faqItems = document.querySelectorAll('.tropi-faq-page .faq-item');

    faqItems.forEach(function (item) {
      const button = item.querySelector('.faq-question');

      button?.addEventListener('click', function () {
        const isActive = item.classList.contains('active');

        faqItems.forEach(function (el) {
          el.classList.remove('active');

          const elButton = el.querySelector('.faq-question');

          if (elButton) {
            elButton.setAttribute('aria-expanded', 'false');
          }
        });

        if (!isActive) {
          item.classList.add('active');
          button.setAttribute('aria-expanded', 'true');
        } else {
          button.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });
</script>

