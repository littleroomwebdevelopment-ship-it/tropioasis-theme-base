<style>
  .tropi-footer {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 90px 6vw 34px;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 0% 0%, rgba(255,208,0,.24) 0 240px, transparent 250px),
      radial-gradient(circle at 100% 100%, rgba(0,167,183,.12) 0 260px, transparent 270px),
      linear-gradient(
        135deg,
        #fffaf0 0%,
        #fff6e7 52%,
        #effff3 100%
      );
    font-family: 'Nunito', sans-serif;
    box-sizing: border-box;
  }

  .footer-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(2px);
  }

  .footer-orb-one {
    width: 220px;
    height: 220px;
    background: #ffd000;
    top: -90px;
    left: -80px;
    opacity: .22;
  }

  .footer-orb-two {
    width: 180px;
    height: 180px;
    background: #00a7b7;
    right: -60px;
    bottom: 40px;
    opacity: .12;
  }

  .footer-shell {
    max-width: 1450px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr .7fr .7fr .9fr;
    gap: 46px;
    position: relative;
    z-index: 2;
  }

  .footer-logo-wrap {
    display: inline-flex;
    width: 120px;
    margin-bottom: 18px;
  }

  .footer-logo {
    width: 120px;
    height: auto;
    display: block;
    filter: drop-shadow(0 12px 18px rgba(0,0,0,.10));
  }

  .footer-brand p {
    max-width: 430px;
    margin: 0;
    color: #4c5360;
    font-size: 17px;
    line-height: 1.5;
    font-weight: 800;
  }

  .footer-socials {
    margin-top: 26px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .footer-socials a {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: .25s ease;
    box-shadow: 0 14px 30px rgba(0,0,0,.10);
  }

  .footer-socials a svg {
    width: 25px;
    height: 25px;
  }

  .footer-socials a:nth-child(1) {
    background:
      radial-gradient(
        circle at 30% 110%,
        #fdf497 0%,
        #fdf497 8%,
        #fd5949 45%,
        #d6249f 60%,
        #285AEB 90%
      );
    color: #fff;
  }

  .footer-socials a:nth-child(2) {
    background: #000;
    color: #fff;
  }

  .footer-socials a:nth-child(3) {
    background: #25D366;
    color: #fff;
  }

  .footer-socials a:hover {
    transform: translateY(-4px) scale(1.05);
  }

  .footer-column,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .footer-column h3,
  .footer-contact h3 {
    margin: 0 0 10px;
    color: #ec0057;
    font-size: 18px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .4px;
  }

  .footer-column a,
  .footer-contact a {
    color: #07112f;
    text-decoration: none;
    font-size: 15px;
    font-weight: 850;
    transition: .2s ease;
    overflow-wrap: anywhere;
  }

  .footer-column a:hover,
  .footer-contact a:hover {
    color: #00a7b7;
    transform: translateX(4px);
  }

  .footer-contact p {
    margin: 8px 0 0;
    color: #4c5360;
    font-size: 14px;
    line-height: 1.5;
    font-weight: 800;
  }

  .footer-bottom {
    max-width: 1450px;
    margin: 56px auto 0;
    padding-top: 24px;
    border-top: 1px solid rgba(0,0,0,.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    position: relative;
    z-index: 2;
  }

  .footer-bottom p,
  .footer-bottom span {
    margin: 0;
    color: #4c5360;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .4px;
  }

  .footer-bottom span {
    color: #ff7a00;
  }

  @media (max-width: 1100px) {
    .footer-shell {
      grid-template-columns: 1.2fr 1fr 1fr;
    }

    .footer-contact {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 800px) {
    .footer-shell {
      grid-template-columns: 1fr 1fr;
      gap: 38px 28px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-contact {
      grid-column: auto;
    }
  }

  @media (max-width: 650px) {
    .tropi-footer {
      padding: 70px 22px 26px;
    }

    .footer-shell {
      grid-template-columns: 1fr;
      gap: 34px;
      text-align: center;
    }

    .footer-logo-wrap {
      margin-left: auto;
      margin-right: auto;
    }

    .footer-brand p {
      margin-left: auto;
      margin-right: auto;
      font-size: 16px;
    }

    .footer-socials {
      justify-content: center;
    }

    .footer-column,
    .footer-contact {
      align-items: center;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-top: 42px;
    }
  }

  @media (max-width: 420px) {
    .tropi-footer {
      padding: 60px 14px 24px;
    }

    .footer-logo,
    .footer-logo-wrap {
      width: 105px;
    }

    .footer-socials a {
      width: 48px;
      height: 48px;
    }

    .footer-socials a svg {
      width: 23px;
      height: 23px;
    }

    .footer-bottom p,
    .footer-bottom span {
      font-size: 11px;
      line-height: 1.4;
    }
  }
</style>

{% schema %}
{
  "name": "TropiOasis Footer",
  "settings": [],
  "presets": [
    {
      "name": "TropiOasis Footer"
    }
  ]
}
{% endschema %}