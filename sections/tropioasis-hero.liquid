<section class="tropi-hero">
  <div class="hero-bg-circle"></div>

  <div class="hero-content">
    <div class="hero-copy">
      <div class="hero-pill">
        <span>💙</span>
        Salud tropical en cada sorbo
      </div>

      <h1>
        Nutre tu<br>
        cuerpo,<br>
        <span>eleva tu</span><br>
        <strong>energía</strong>
      </h1>

      <p>
        Jugos Cold Press, Wellness Shots e Infusiones hechos con ingredientes
        frescos, naturales y llenos de vida para tu bienestar diario.
      </p>

      <div class="hero-buttons">
        <a href="/collections/all" class="btn-primary">
          Comprar ahora
          <span>→</span>
        </a>

        <a href="/collections/functional-juices" class="btn-secondary">
          Descubrir más
        </a>
      </div>

      <div class="hero-benefits">
        <div>
          <span>🌱</span>
          <p>Ingredientes<br>Naturales</p>
        </div>

        <div>
          <span>💧</span>
          <p>Prensado<br>en Frío</p>
        </div>

        <div>
          <span>💗</span>
          <p>Bienestar<br>Integral</p>
        </div>

        <div>
          <span>🛡️</span>
          <p>Fortalece tu<br>Inmunidad</p>
        </div>
      </div>
    </div>

    <div class="hero-image-wrap">
      <div class="natural-badge">
        <strong>100%</strong>
        <span>Natural</span>
      </div>

      <img
        src="{{ 'hero-juices.png' | asset_url }}"
        alt="Jugos TropiOasis"
        class="hero-image"
      >
    </div>
  </div>

  <div class="hero-info-bar">
    <div>
      <span>🚚</span>
      <p>
        <strong>Entrega rápida</strong>
        <small>A todo Puerto Rico</small>
      </p>
    </div>

    <div>
      <span>✅</span>
      <p>
        <strong>Pagos seguros</strong>
        <small>100% protegidos</small>
      </p>
    </div>

    <div>
      <span>🌱</span>
      <p>
        <strong>Productos frescos</strong>
        <small>Hechos al momento</small>
      </p>
    </div>

    <div>
      <span>🎧</span>
      <p>
        <strong>Atención al cliente</strong>
        <small>¡Estamos para ti!</small>
      </p>
    </div>
  </div>
</section>

<style>
  .tropi-hero {
    position: relative;
    width: 100vw;
    min-height: calc(100vh - 105px);
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 70px 7vw 120px;
    background:
      radial-gradient(circle at left top, #fff0bb 0 16%, transparent 16.5%),
      linear-gradient(115deg, #fffaf0 0%, #fffaf0 67%, #eefbf1 100%);
    overflow: hidden;
  }

  .hero-bg-circle {
    position: absolute;
    left: -90px;
    top: -60px;
    width: 310px;
    height: 310px;
    border-radius: 50%;
    background: rgba(255, 215, 72, .28);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1500px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    align-items: center;
    gap: 40px;
  }

  .hero-pill {
    width: max-content;
    max-width: 100%;
    padding: 12px 28px;
    border: 2px solid #ec0057;
    border-radius: 999px;
    background: rgba(255,255,255,.55);
    color: #07112f;
    text-transform: uppercase;
    font-weight: 900;
    font-size: 14px;
    margin-bottom: 26px;
  }

  .hero-pill span {
    margin-right: 10px;
  }

  .hero-copy h1 {
    margin: 0 0 26px;
    font-family: 'Nunito', sans-serif;
    font-size: clamp(58px, 5.4vw, 98px);
    line-height: .92;
    letter-spacing: -3px;
    font-weight: 900;
    color: #00a7b7;
    text-shadow: 0 8px 0 rgba(0,167,183,.09);
  }

  .hero-copy h1 span {
    color: #ec0057;
  }

  .hero-copy h1 strong {
    color: #ff6f00;
    font-weight: 900;
  }

  .hero-copy p {
    max-width: 600px;
    margin: 0 0 34px;
    color: #07112f;
    font-size: 22px;
    line-height: 1.36;
    font-weight: 900;
  }

  .hero-buttons {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
  }

  .hero-buttons a {
    height: 58px;
    padding: 0 36px;
    border-radius: 999px;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 900;
    font-size: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-primary {
    background: #ec0057;
    color: #fff;
    box-shadow: 0 18px 32px rgba(236,0,87,.26);
  }

  .btn-primary span {
    margin-left: 28px;
    font-size: 24px;
  }

  .btn-secondary {
    color: #00a7b7;
    border: 2px solid #00a7b7;
    background: rgba(255,255,255,.45);
  }

  .hero-benefits {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
    max-width: 620px;
  }

  .hero-benefits div {
    text-align: center;
    color: #07112f;
  }

  .hero-benefits span {
    display: block;
    font-size: 34px;
    margin-bottom: 8px;
  }

  .hero-benefits p {
    margin: 0;
    font-size: 14px;
    line-height: 1.05;
    font-weight: 900;
  }

  .hero-image-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image {
    width: min(860px, 58vw);
    height: auto;
    display: block;
    filter: drop-shadow(0 30px 36px rgba(0,90,70,.12));
  }

  .natural-badge {
    position: absolute;
    right: 6%;
    top: 25%;
    z-index: 3;
    width: 118px;
    height: 118px;
    border-radius: 50%;
    background: #ec0057;
    color: #fff;
    display: grid;
    place-items: center;
    text-align: center;
    text-transform: uppercase;
    box-shadow: 0 16px 30px rgba(236,0,87,.24);
  }

  .natural-badge strong {
    font-size: 32px;
    line-height: .9;
  }

  .natural-badge span {
    display: block;
    font-size: 14px;
    font-weight: 900;
    margin-top: -24px;
  }

  .hero-info-bar {
    position: absolute;
    left: 50%;
    bottom: 34px;
    transform: translateX(-50%);
    z-index: 4;
    width: min(1120px, 78vw);
    min-height: 82px;
    background: rgba(255,255,255,.95);
    border-radius: 18px;
    box-shadow: 0 18px 42px rgba(0,0,0,.12);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    overflow: hidden;
  }

  .hero-info-bar div {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 0 22px;
    border-right: 1px solid rgba(0,0,0,.08);
  }

  .hero-info-bar div:last-child {
    border-right: 0;
  }

  .hero-info-bar span {
    font-size: 28px;
  }

  .hero-info-bar p {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .hero-info-bar strong {
    color: #07112f;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 900;
  }

  .hero-info-bar small {
    color: #4d5360;
    font-size: 12px;
    font-weight: 800;
  }

  @media (max-width: 1100px) {
    .tropi-hero {
      padding: 50px 24px 150px;
    }

    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-pill {
      margin-inline: auto;
    }

    .hero-copy p {
      margin-inline: auto;
    }

    .hero-buttons {
      justify-content: center;
    }

    .hero-benefits {
      margin-inline: auto;
    }

    .hero-image {
      width: min(850px, 94vw);
    }

    .hero-info-bar {
      position: relative;
      left: auto;
      bottom: auto;
      transform: none;
      margin: 40px auto 0;
      width: min(900px, 94vw);
    }
  }

  @media (max-width: 700px) {
    .hero-copy h1 {
      font-size: 54px;
    }

    .hero-copy p {
      font-size: 18px;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .hero-buttons a {
      width: 100%;
    }

    .hero-benefits {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-info-bar {
      grid-template-columns: 1fr;
    }

    .hero-info-bar div {
      min-height: 76px;
      border-right: 0;
      border-bottom: 1px solid rgba(0,0,0,.08);
    }

    .natural-badge {
      width: 90px;
      height: 90px;
      right: 2%;
      top: 18%;
    }

    .natural-badge strong {
      font-size: 24px;
    }

    .natural-badge span {
      font-size: 11px;
      margin-top: -18px;
    }
  }
</style>

