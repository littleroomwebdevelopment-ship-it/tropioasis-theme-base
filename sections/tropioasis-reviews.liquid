{% assign jm = shop.metafields.judgeme %}

{% assign review_count = jm.all_reviews_count | default: 0 | plus: 0 %}
{% assign avg_rating = jm.all_reviews_rating | default: 0 | plus: 0 %}

{% assign filled_stars = avg_rating | round %}
{% if filled_stars > 5 %}
  {% assign filled_stars = 5 %}
{% endif %}

{% assign empty_stars = 5 | minus: filled_stars %}

<section id="reviews" class="tropi-reviews">

  <div class="reviews-sparkle sparkle-one">✦</div>
  <div class="reviews-sparkle sparkle-two">✦</div>

  <div class="reviews-header">
    <span class="reviews-kicker">Opiniones de clientes</span>

    <h2>
      Amado por la
      <span>comunidad TropiOasis</span>
    </h2>

    <p class="reviews-subtitle">
      Opiniones reales de clientes reales que aman nuestros jugos y shots de bienestar.
    </p>
  </div>

  <div class="reviews-overview-card">

    <div class="overview-main">
      <div class="overview-score">
        {{ avg_rating | round: 1 }}
      </div>

      <div class="overview-stars-block">
        <div class="overview-stars" aria-label="{{ avg_rating | round: 1 }} de 5 estrellas">
          {% for i in (1..filled_stars) %}★{% endfor %}{% for i in (1..empty_stars) %}☆{% endfor %}
        </div>

        <div class="overview-count">
          Basado en
          <strong>{{ review_count }}</strong>
          {% if review_count == 1 %}
            opinión
          {% else %}
            opiniones
          {% endif %}
        </div>
      </div>
    </div>

    <div class="overview-divider"></div>

    <div class="overview-breakdown">

      <div class="rating-row">
        <span>5 ★</span>
        <div class="rating-bar">
          <div style="width: {% if review_count > 0 %}100{% else %}0{% endif %}%"></div>
        </div>
        <strong>{% if review_count > 0 %}{{ review_count }}{% else %}0{% endif %} ({% if review_count > 0 %}100{% else %}0{% endif %}%)</strong>
      </div>

      <div class="rating-row">
        <span>4 ★</span>
        <div class="rating-bar"><div style="width: 0%"></div></div>
        <strong>0 (0%)</strong>
      </div>

      <div class="rating-row">
        <span>3 ★</span>
        <div class="rating-bar"><div style="width: 0%"></div></div>
        <strong>0 (0%)</strong>
      </div>

      <div class="rating-row">
        <span>2 ★</span>
        <div class="rating-bar"><div style="width: 0%"></div></div>
        <strong>0 (0%)</strong>
      </div>

      <div class="rating-row">
        <span>1 ★</span>
        <div class="rating-bar"><div style="width: 0%"></div></div>
        <strong>0 (0%)</strong>
      </div>

    </div>

    <div class="reviews-trust-row">
      <div>
        <svg viewBox="0 0 24 24">
          <path d="M12 22S5 18 5 10V5L12 2L19 5V10C19 18 12 22 12 22Z"></path>
          <path d="M9 12L11 14L15 9"></path>
        </svg>
        Compras verificadas
      </div>

      <div>
        <svg viewBox="0 0 24 24">
          <path d="M20 12A8 8 0 1 1 12 4"></path>
          <path d="M20 4V10H14"></path>
        </svg>
        Clientes reales
      </div>

      <div>
        <svg viewBox="0 0 24 24">
          <path d="M20.8 4.6A5.5 5.5 0 0 0 13 4.6L12 5.6L11 4.6A5.5 5.5 0 0 0 3.2 12.4L12 21L20.8 12.4A5.5 5.5 0 0 0 20.8 4.6Z"></path>
        </svg>
        Opiniones honestas
      </div>
    </div>

  </div>

  <div class="judgeme-all-reviews">
    {{ shop.metafields.judgeme.featured_carousel }}
  </div>

  <div class="submit-review-panel">

    <div class="submit-icon">
      <svg viewBox="0 0 24 24">
        <path d="M12 20H21"></path>
        <path d="M16.5 3.5A2.1 2.1 0 0 1 19.5 6.5L8 18L4 19L5 15L16.5 3.5Z"></path>
      </svg>
    </div>

    <div class="submit-copy">
      <h3>Comparte tu experiencia</h3>
      <p>
        Tu opinión ayuda a otros a descubrir su próximo jugo favorito y nos ayuda a seguir mejorando.
      </p>
    </div>

    <div class="submit-field">
      <label for="review-product-select">Selecciona un producto</label>

      <select id="review-product-select">
        <option value="">Elige un producto</option>
        <option value="/products/green-juice-detox">Green Juice Detox</option>
        <option value="/products/passion-juice-bright-shield">Passion Juice</option>
        <option value="/products/yellow-juice">Yellow Juice</option>
        <option value="/products/pink-juice-hydration-boost">Pink Juice</option>
        <option value="/products/immune-support-shot-200ml">Immune Support Shot</option>
        <option value="/products/custom-juice-25oz">Custom Juice 25oz</option>
        <option value="/products/custom-juice-32oz">Custom Juice 32oz</option>
        <option value="/products/custom-juice-pack-4-x-8oz">Custom Juice Pack</option>
        <option value="/products/custom-wellness-shots-7-x-2oz">Custom Wellness Shots</option>
      </select>

      <small>
        Tu opinión será pública y puede ayudar a otros clientes.
      </small>
    </div>

    <button type="button" class="write-review-btn" id="write-review-btn">
      Escribir una opinión
    </button>

  </div>

</section>

<style>
  .tropi-reviews {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 105px 6vw 90px;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 0% 0%, rgba(255, 208, 0, .30) 0 210px, transparent 225px),
      radial-gradient(circle at 100% 84%, rgba(0, 167, 183, .17) 0 260px, transparent 275px),
      radial-gradient(circle at 0% 100%, rgba(236, 0, 87, .14) 0 160px, transparent 180px),
      linear-gradient(135deg, #fffaf0 0%, #fff7eb 55%, #effff3 100%);
    font-family: 'Nunito', sans-serif;
    box-sizing: border-box;
  }

  .reviews-sparkle {
    position: absolute;
    color: #ffd000;
    font-size: 36px;
    font-weight: 900;
    opacity: .75;
    pointer-events: none;
  }

  .sparkle-one {
    top: 70px;
    right: 10vw;
  }

  .sparkle-two {
    bottom: 140px;
    left: 4vw;
  }

  .reviews-header {
    max-width: 1050px;
    margin: 0 auto 42px;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .reviews-kicker {
    display: inline-block;
    padding: 12px 26px;
    border-radius: 999px;
    border: 2px solid #ec0057;
    background: #fff;
    color: #07112f;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    box-shadow: 0 12px 24px rgba(236, 0, 87, .08);
  }

  .reviews-header h2 {
    margin: 22px 0 0;
    font-size: clamp(50px, 5.7vw, 96px);
    line-height: .88;
    font-weight: 900;
    color: #ff7a00;
    letter-spacing: -3px;
  }

  .reviews-header h2 span {
    display: block;
    color: #ec0057;
  }

  .reviews-subtitle {
    max-width: 760px;
    margin: 22px auto 0;
    color: #4c5360;
    font-size: 20px;
    line-height: 1.4;
    font-weight: 800;
  }

  .reviews-overview-card {
    max-width: 880px;
    margin: 0 auto 42px;
    background: rgba(255, 255, 255, .94);
    border: 1px solid rgba(0, 0, 0, .05);
    border-radius: 30px;
    padding: 30px 36px 22px;
    box-shadow: 0 24px 58px rgba(0, 0, 0, .09);
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: 28px;
    align-items: center;
    position: relative;
    z-index: 2;
    box-sizing: border-box;
  }

  .overview-main {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    min-width: 0;
  }

  .overview-score {
    font-size: 78px;
    line-height: 1;
    font-weight: 900;
    color: #00a7b7;
    letter-spacing: -3px;
  }

  .overview-stars {
    color: #ffb800;
    font-size: 34px;
    line-height: 1;
    letter-spacing: 3px;
    font-weight: 900;
    white-space: nowrap;
  }

  .overview-count {
    margin-top: 8px;
    color: #07112f;
    font-size: 17px;
    font-weight: 900;
  }

  .overview-count strong {
    color: #ec0057;
  }

  .overview-divider {
    width: 1px;
    height: 118px;
    background: rgba(7, 17, 47, .12);
  }

  .overview-breakdown {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .rating-row {
    display: grid;
    grid-template-columns: 42px 1fr 76px;
    align-items: center;
    gap: 12px;
  }

  .rating-row span,
  .rating-row strong {
    color: #3e4758;
    font-size: 14px;
    font-weight: 900;
  }

  .rating-row strong {
    text-align: right;
    white-space: nowrap;
  }

  .rating-bar {
    height: 9px;
    border-radius: 999px;
    background: #e6e8ed;
    overflow: hidden;
  }

  .rating-bar div {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #ffb800, #ff7a00);
  }

  .reviews-trust-row {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 34px;
    padding-top: 22px;
    border-top: 1px solid rgba(7, 17, 47, .09);
    flex-wrap: wrap;
  }

  .reviews-trust-row div {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #4c5360;
    font-size: 14px;
    font-weight: 900;
  }

  .reviews-trust-row svg {
    width: 22px;
    height: 22px;
    stroke: #00a7b7;
    stroke-width: 2.4;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  .reviews-trust-row div:nth-child(3) svg {
    stroke: #ec0057;
  }

  .judgeme-all-reviews {
    max-width: 980px;
    margin: 0 auto 42px;
    position: relative;
    z-index: 2;
  }

  /* Caja general del carousel */
  .judgeme-all-reviews .jdgm-carousel-wrapper {
    background:
      radial-gradient(circle at 8% 0%, rgba(255, 208, 0, .38) 0 92px, transparent 118px),
      radial-gradient(circle at 100% 24%, rgba(0, 167, 183, .18) 0 150px, transparent 185px),
      linear-gradient(135deg, #fff 0%, #fff6df 44%, #effff7 100%) !important;
    border-radius: 34px !important;
    padding: 32px 42px 34px !important;
    box-shadow:
      0 24px 58px rgba(0,0,0,.09),
      0 18px 46px rgba(236,0,87,.10) !important;
    border: 2px solid rgba(255,255,255,.92) !important;
    overflow: visible !important;
  }

  /* NO escondas las flechas ni el carrusel completo */
  .judgeme-all-reviews .jdgm-carousel-title,
  .judgeme-all-reviews .jdgm-carousel-number-of-reviews {
    display: none !important;
  }

  /* Contenedor interno */
  .judgeme-all-reviews .jdgm-carousel {
    background: rgba(255,255,255,.82) !important;
    border-radius: 26px !important;
    padding: 16px 18px 8px !important;
    box-shadow:
      inset 0 0 0 1px rgba(7,17,47,.05),
      0 12px 30px rgba(0,167,183,.08) !important;
    box-sizing: border-box !important;
    overflow: visible !important;
  }

  .judgeme-all-reviews .jdgm-carousel__item-wrapper {
    min-height: 235px !important;
    overflow: visible !important;
  }

  /* Review individual */
  .judgeme-all-reviews .jdgm-carousel-item {
    text-align: center !important;
    padding: 18px 14px !important;
    height: auto !important;
    min-height: 215px !important;
    background: transparent !important;
    box-shadow: none !important;
    border: none !important;
    overflow: visible !important;
  }

  /* Estrellas */
  .judgeme-all-reviews .jdgm-star {
    color: #ffb800 !important;
    font-size: 25px !important;
    text-shadow: 0 5px 14px rgba(255,184,0,.24) !important;
  }

  /* Texto */
  .judgeme-all-reviews .jdgm-carousel-item__review-body,
  .judgeme-all-reviews .jdgm-carousel-item__review-body p,
  .judgeme-all-reviews .jdgm-carousel-item__review-body span {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    color: #07112f !important;
    font-size: 19px !important;
    line-height: 1.35 !important;
    font-weight: 900 !important;
    margin: 12px auto 8px !important;
    max-width: 300px !important;
    white-space: normal !important;
    overflow: visible !important;
    text-overflow: unset !important;
    transform: none !important;
    -webkit-line-clamp: unset !important;
    -webkit-box-orient: unset !important;
    clip-path: none !important;
  }

  .judgeme-all-reviews .jdgm-carousel-item__review-body p,
  .judgeme-all-reviews .jdgm-carousel-item__review-body span {
    margin: 0 auto !important;
  }

  /* Nombre */
  .judgeme-all-reviews .jdgm-carousel-item__reviewer-name {
    color: #ec0057 !important;
    font-size: 14px !important;
    font-weight: 900 !important;
  }

  /* Producto */
  .judgeme-all-reviews .jdgm-carousel-item__product,
  .judgeme-all-reviews .jdgm-carousel-item__product-title {
    display: block !important;
    margin-top: 10px !important;
    color: #00a7b7 !important;
    font-size: 13px !important;
    font-weight: 900 !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
  }

  .judgeme-all-reviews .jdgm-carousel__left-arrow,
  .judgeme-all-reviews .jdgm-carousel__right-arrow {
    color: #ec0057 !important;
    filter: drop-shadow(0 8px 18px rgba(236,0,87,.20)) !important;
    margin-top: -10px !important;
    top: 38% !important;
  }

  .judgeme-all-reviews .jdgm-carousel__arrows {
    display: flex !important;
    justify-content: center !important;
    gap: 34px !important;
    margin-top: -34px !important;
    transform: translateY(-8px) !important;
  }

  /* Solo escondemos imágenes */
  .judgeme-all-reviews .jdgm-carousel-item__product-image,
  .judgeme-all-reviews img {
    display: none !important;
  }

  @media (max-width: 650px) {
    .judgeme-all-reviews {
      max-width: 100%;
    }

    .judgeme-all-reviews .jdgm-carousel-wrapper {
      padding: 24px 18px 30px !important;
      border-radius: 26px !important;
    }

    .judgeme-all-reviews .jdgm-carousel-item__review-body {
      font-size: 17px !important;
    }
  }

  /* Ocultar scrollbar del carousel */
  .judgeme-all-reviews .jdgm-carousel::-webkit-scrollbar,
  .judgeme-all-reviews .jdgm-carousel__item-wrapper::-webkit-scrollbar {
    display: none !important;
  }

  .judgeme-all-reviews .jdgm-carousel,
  .judgeme-all-reviews .jdgm-carousel__item-wrapper {
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
  }

  .submit-review-panel {
    max-width: 1450px;
    margin: 36px auto 0;
    padding: 28px 34px;
    border-radius: 30px;
    background:
      linear-gradient(90deg, rgba(236, 0, 87, .13), rgba(255, 255, 255, .82), rgba(0, 167, 183, .15));
    border: 1px solid rgba(0, 0, 0, .05);
    box-shadow: 0 24px 58px rgba(0, 0, 0, .08);
    display: grid;
    grid-template-columns: auto 1.3fr 1fr auto;
    gap: 26px;
    align-items: center;
    position: relative;
    z-index: 2;
    box-sizing: border-box;
  }

  .submit-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(236, 0, 87, .16);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .submit-icon svg {
    width: 32px;
    height: 32px;
    stroke: #ec0057;
    stroke-width: 2.4;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .submit-copy h3 {
    margin: 0 0 6px;
    color: #07112f;
    font-size: 28px;
    line-height: 1;
    font-weight: 900;
  }

  .submit-copy p {
    margin: 0;
    color: #4c5360;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 800;
  }

  .submit-field label {
    display: block;
    margin-bottom: 9px;
    color: #07112f;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .submit-field select {
    width: 100%;
    height: 54px;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, .12);
    background: #fff;
    padding: 0 16px;
    color: #07112f;
    font-family: 'Nunito', sans-serif;
    font-size: 14px;
    font-weight: 900;
    outline: none;
    box-sizing: border-box;
  }

  .submit-field small {
    display: block;
    margin-top: 10px;
    color: #4c5360;
    font-size: 13px;
    font-weight: 800;
  }

  .write-review-btn {
    height: 58px;
    padding: 0 34px;
    border: 0;
    border-radius: 999px;
    background: #07112f;
    color: #fff;
    font-family: 'Nunito', sans-serif;
    font-size: 15px;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 18px 34px rgba(236, 0, 87, .20);
    transition: .22s ease;
    white-space: nowrap;
  }

  .write-review-btn:hover {
    background: #00a7b7;
    transform: translateY(-3px);
  }

  @media (max-width: 1150px) {
    .reviews-overview-card {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .overview-divider {
      display: none;
    }

    .submit-review-panel {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .submit-icon {
      margin: 0 auto;
    }
  }

  @media (max-width: 900px) {
    .tropi-reviews {
      padding: 90px 28px;
    }

    .overview-main {
      flex-direction: column;
    }

    .rating-row {
      grid-template-columns: 42px 1fr 70px;
    }
  }

  @media (max-width: 650px) {
    .tropi-reviews {
      padding: 80px 20px;
    }

    .reviews-header h2 {
      font-size: clamp(42px, 13vw, 50px);
      letter-spacing: -2px;
    }

    .reviews-subtitle {
      font-size: 17px;
    }

    .reviews-overview-card {
      padding: 28px 20px;
      border-radius: 24px;
    }

    .overview-score {
      font-size: 66px;
    }

    .overview-stars {
      font-size: 28px;
      letter-spacing: 2px;
    }

    .reviews-trust-row {
      gap: 16px;
      justify-content: flex-start;
    }

    .reviews-trust-row div {
      width: 100%;
      justify-content: flex-start;
    }

    .submit-review-panel {
      padding: 26px 20px;
      border-radius: 24px;
    }

    .submit-copy h3 {
      font-size: 24px;
    }

    .write-review-btn {
      width: 100%;
    }

  }

  @media (max-width: 480px) {
    .tropi-reviews {
      padding: 64px 14px;
    }

    .reviews-kicker {
      width: 100%;
      box-sizing: border-box;
      font-size: 11px;
      padding: 10px 16px;
    }

    .reviews-header h2 {
      font-size: 38px;
      letter-spacing: -1.5px;
    }

    .reviews-subtitle {
      font-size: 16px;
    }

    .overview-score {
      font-size: 58px;
    }

    .overview-stars {
      font-size: 24px;
      letter-spacing: 1px;
    }

    .overview-count {
      font-size: 15px;
    }

    .rating-row {
      grid-template-columns: 36px 1fr 62px;
      gap: 9px;
    }

    .rating-row span,
    .rating-row strong {
      font-size: 12px;
    }

    .submit-icon {
      width: 62px;
      height: 62px;
    }

    .submit-copy h3 {
      font-size: 22px;
    }

    .submit-copy p,
    .submit-field small {
      font-size: 14px;
    }

    .submit-field select {
      height: 52px;
      font-size: 13px;
    }

    .write-review-btn {
      height: 52px;
      font-size: 13px;
      padding: 0 20px;
    }

  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const select = document.querySelector('#review-product-select');
    const button = document.querySelector('#write-review-btn');

    if (button && select) {
      button.addEventListener('click', function () {
        const productUrl = select.value;

        if (productUrl) {
          window.location.href = productUrl + '?write_review=true#judgeme_product_reviews';
        } else {
          window.location.href = '/collections/all';
        }
      });
    }

    setInterval(function () {
      const nextArrow = document.querySelector(
        '.judgeme-all-reviews .jdgm-carousel__right-arrow'
      );

      if (nextArrow) {
        nextArrow.click();
      }
    }, 2500);
  });
</script>

{% schema %}
{
  "name": "Opiniones TropiOasis",
  "settings": [],
  "presets": [
    {
      "name": "Opiniones TropiOasis"
    }
  ]
}
{% endschema %}
