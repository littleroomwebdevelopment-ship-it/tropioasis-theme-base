<style>

.tropi-contact-section{
  width:100vw;
  margin-left:calc(50% - 50vw);
  margin-right:calc(50% - 50vw);
  padding:115px 6vw;
  position:relative;
  overflow:hidden;
  background:
    radial-gradient(circle at 0% 0%, rgba(255,208,0,.24) 0 240px, transparent 250px),
    radial-gradient(circle at 100% 100%, rgba(0,167,183,.12) 0 260px, transparent 270px),
    linear-gradient(135deg,#fffaf0 0%,#fff7ea 55%,#effff3 100%);
  font-family:'Nunito',sans-serif;
}

.contact-orb{
  position:absolute;
  border-radius:50%;
  filter:blur(2px);
  pointer-events:none;
}

.contact-orb-one{
  width:220px;
  height:220px;
  background:#ffd000;
  top:-70px;
  left:-70px;
  opacity:.42;
}

.contact-orb-two{
  width:180px;
  height:180px;
  background:#ffb800;
  right:-50px;
  bottom:100px;
  opacity:.16;
}

.contact-shell{
  max-width:1450px;
  margin:0 auto;
  display:grid;
  grid-template-columns:.88fr 1.12fr;
  gap:54px;
  align-items:center;
  position:relative;
  z-index:2;
}

.contact-kicker{
  display:inline-block;
  padding:11px 24px;
  border-radius:999px;
  border:2px solid #ff7a00;
  background:rgba(255,255,255,.82);
  color:#07112f;
  font-size:13px;
  font-weight:900;
  text-transform:uppercase;
  margin-bottom:22px;
}

.contact-copy h2{
  margin:0;
  font-size:clamp(60px,6vw,108px);
  line-height:.88;
  font-weight:900;
  color:#00a7b7;
  letter-spacing:-4px;
  text-shadow:0 9px 0 rgba(0,167,183,.08);
}

.contact-copy h2 strong{
  display:block;
  color:#ec0057;
}

.contact-copy p{
  max-width:610px;
  margin:28px 0 0;
  color:#07112f;
  font-size:21px;
  line-height:1.45;
  font-weight:850;
}

.contact-mini-note{
  margin-top:34px;
  display:flex;
  align-items:center;
  gap:18px;
  max-width:590px;
  padding:18px;
  border-radius:24px;
  background:rgba(255,255,255,.78);
  border:1px solid rgba(0,0,0,.06);
  box-shadow:0 16px 34px rgba(0,0,0,.07);
}

.note-icon{
  width:58px;
  height:58px;
  min-width:58px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#fff;
  border:2px solid #00a7b7;
  font-size:24px;
}

.contact-mini-note strong{
  display:block;
  color:#008c9c;
  font-size:18px;
  font-weight:900;
}

.contact-mini-note span{
  display:block;
  color:#07112f;
  font-size:15px;
  font-weight:850;
}

.contact-card-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:22px;
}

.contact-card{
  min-height:245px;
  padding:26px;
  border-radius:32px;
  background:rgba(255,255,255,.92);
  border:1px solid rgba(0,0,0,.06);
  box-shadow:0 24px 55px rgba(0,0,0,.10);
  text-decoration:none;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  transition:.25s ease;
  color:#07112f;
}

.contact-card:hover{
  transform:translateY(-8px);
  box-shadow:0 34px 75px rgba(0,0,0,.15);
}

.contact-icon{
  width:68px;
  height:68px;
  border-radius:22px;
  display:grid;
  place-items:center;
  margin-bottom:26px;
}

.contact-icon svg{
  width:34px;
  height:34px;
  fill:#fff;
}

.contact-card span{
  display:block;
  font-size:12px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.7px;
  margin-bottom:8px;
}

.contact-card h3{
  margin:0 0 10px;
  color:#07112f;
  font-size:25px;
  line-height:1;
  font-weight:900;
}

.contact-card p{
  margin:0;
  color:#4c5360;
  font-size:15px;
  line-height:1.45;
  font-weight:800;
}

.whatsapp .contact-icon{
  background:#25D366;
}

.whatsapp span{
  color:#25D366;
}

.email .contact-icon{
  background:#ff7a00;
}

.email span{
  color:#ff7a00;
}

.instagram .contact-icon{
  background:
    radial-gradient(circle at 30% 110%, #ffdc80 0 18%, #fcaf45 19% 34%, #f77737 35% 50%, #c13584 51% 72%, #833ab4 73% 100%);
}

.instagram span{
  color:#c13584;
}

.tiktok .contact-icon{
  background:#111;
}

.tiktok span{
  color:#111;
}

@media(max-width:1050px){

  .contact-shell{
    grid-template-columns:1fr;
  }

  .contact-copy{
    text-align:center;
  }

  .contact-copy p,
  .contact-mini-note{
    margin-left:auto;
    margin-right:auto;
  }

}

@media(max-width:700px){

  .tropi-contact-section{
    padding:80px 20px;
  }

  .contact-copy h2{
    font-size:58px;
    letter-spacing:-2px;
  }

  .contact-copy p{
    font-size:18px;
  }

  .contact-card-grid{
    grid-template-columns:1fr;
  }

  .contact-card{
    min-height:auto;
  }

}

</style>

