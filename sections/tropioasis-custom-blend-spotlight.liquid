{% assign custom_25 = all_products['custom-juice-25oz'] %}
{% assign custom_32 = all_products['custom-juice-32oz'] %}
{% assign custom_pack = all_products['custom-juice-pack-4-x-8oz'] %}
{% assign custom_shots = all_products['custom-wellness-shots-7-x-2oz'] %}

<section class="blend-spotlight">
  <div class="blend-orb orb-one"></div>
  <div class="blend-orb orb-two"></div>

  <div class="blend-shell">

    <div class="blend-copy">
      <span class="blend-kicker">Juice Bar Experience</span>

      <h2>
        Create Your Own
        <strong>Tropical Blend</strong>
      </h2>

      <p>
        Escoge tu tamaño, combina ingredientes frescos y crea un jugo
        o wellness shot hecho a tu gusto.
      </p>

      <div class="blend-actions">
        <a href="/collections/juice-bar" class="blend-main-btn">
          Start Blending
        </a>

        <a href="/collections/juice-bar" class="blend-secondary-btn">
          Ver opciones
        </a>
      </div>

      <div class="blend-points">
        <div>🍍 20+ ingredientes</div>
        <div>💧 Cold pressed</div>
        <div>🌿 Fresh daily</div>
        <div>🇵🇷 Hecho en PR</div>
      </div>
    </div>

    <div class="blend-cards">

      <a href="{{ custom_25.url }}" class="mini-blend-card green">
        {% if custom_25.featured_image %}
          <img src="{{ custom_25.featured_image | image_url: width: 700 }}" alt="{{ custom_25.title }}">
        {% endif %}
        <div>
          <span>25oz</span>
          <h3>Custom Juice</h3>
          <strong>$22</strong>
        </div>
      </a>

      <a href="{{ custom_32.url }}" class="mini-blend-card orange">
        {% if custom_32.featured_image %}
          <img src="{{ custom_32.featured_image | image_url: width: 700 }}" alt="{{ custom_32.title }}">
        {% endif %}
        <div>
          <span>32oz</span>
          <h3>Big Custom Juice</h3>
          <strong>$28</strong>
        </div>
      </a>

      <a href="{{ custom_pack.url }}" class="mini-blend-card blue">
        {% if custom_pack.featured_image %}
          <img src="{{ custom_pack.featured_image | image_url: width: 700 }}" alt="{{ custom_pack.title }}">
        {% endif %}
        <div>
          <span>4 x 8oz</span>
          <h3>Juice Pack</h3>
          <strong>$24</strong>
        </div>
      </a>

      <a href="{{ custom_shots.url }}" class="mini-blend-card pink">
        {% if custom_shots.featured_image %}
          <img src="{{ custom_shots.featured_image | image_url: width: 700 }}" alt="{{ custom_shots.title }}">
        {% endif %}
        <div>
          <span>7 x 2oz</span>
          <h3>Wellness Shots</h3>
          <strong>$20</strong>
        </div>
      </a>

    </div>

  </div>
</section>

<style>
  .blend-spotlight {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 110px 6vw;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 10% 15%, rgba(255, 208, 0, .28) 0 230px, transparent 240px),
      radial-gradient(circle at 95% 80%, rgba(236, 0, 87, .15) 0 240px, transparent 255px),
      linear-gradient(135deg, #fffaf0 0%, #fff3df 52%, #eafff3 100%);
    font-family: 'Nunito', sans-serif;
  }

  .blend-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: .55;
    pointer-events: none;
  }

  .orb-one {
    width: 180px;
    height: 180px;
    background: #00a7b7;
    right: -60px;
    top: 80px;
  }

  .orb-two {
    width: 220px;
    height: 220px;
    background: #ffd000;
    left: -80px;
    bottom: 120px;
  }

  .blend-shell {
    max-width: 1500px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: 56px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .blend-kicker {
    display: inline-block;
    padding: 11px 24px;
    border-radius: 999px;
    border: 2px solid #ec0057;
    background: #fff;
    color: #07112f;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 22px;
  }

  .blend-copy h2 {
    margin: 0;
    font-size: clamp(58px, 6vw, 108px);
    line-height: .88;
    font-weight: 900;
    color: #00a7b7;
    letter-spacing: -4px;
    text-shadow: 0 9px 0 rgba(0,167,183,.08);
  }

  .blend-copy h2 strong {
    display: block;
    color: #ec0057;
  }

  .blend-copy p {
    max-width: 590px;
    margin: 28px 0 0;
    color: #07112f;
    font-size: 22px;
    line-height: 1.35;
    font-weight: 900;
  }

  .blend-actions {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .blend-main-btn,
  .blend-secondary-btn {
    min-height: 58px;
    padding: 0 30px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 14px;
    font-weight: 900;
    text-transform: uppercase;
    transition: .22s ease;
  }

  .blend-main-btn {
    background: linear-gradient(90deg, #ec0057, #ff7a00, #00a7b7);
    color: #fff;
    box-shadow: 0 18px 35px rgba(236,0,87,.22);
  }

  .blend-secondary-btn {
    background: #fff;
    color: #07112f;
    border: 2px solid rgba(0,167,183,.35);
  }

  .blend-main-btn:hover,
  .blend-secondary-btn:hover {
    transform: translateY(-3px);
  }

  .blend-points {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    max-width: 580px;
  }

  .blend-points div {
    background: rgba(255,255,255,.78);
    border: 1px solid rgba(0,0,0,.06);
    border-radius: 18px;
    padding: 14px 16px;
    color: #07112f;
    font-size: 14px;
    font-weight: 900;
    box-shadow: 0 12px 28px rgba(0,0,0,.06);
  }

  .blend-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .mini-blend-card {
    position: relative;
    min-height: 390px;
    border-radius: 34px;
    overflow: hidden;
    text-decoration: none;
    background: #fff;
    box-shadow: 0 24px 58px rgba(0,0,0,.12);
    transition: .28s ease;
  }

  .mini-blend-card:hover {
    transform: translateY(-10px) rotate(-1deg);
    box-shadow: 0 34px 78px rgba(0,0,0,.16);
  }

  .mini-blend-card:nth-child(even):hover {
    transform: translateY(-10px) rotate(1deg);
  }

  .mini-blend-card img {
    width: 100%;
    height: 260px;
    object-fit: contain;
    background: #fffaf0;
    display: block;
  }

  .mini-blend-card div {
    padding: 22px;
  }

  .mini-blend-card span {
    display: inline-flex;
    min-width: 70px;
    height: 34px;
    padding: 0 13px;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 12px;
    font-weight: 900;
    margin-bottom: 12px;
  }

  .mini-blend-card h3 {
    margin: 0 0 8px;
    color: #07112f;
    font-size: 25px;
    line-height: 1;
    font-weight: 900;
  }

  .mini-blend-card strong {
    color: #ff6f00;
    font-size: 28px;
    font-weight: 900;
  }

  .green span { background: #59b52c; }
  .orange span { background: #ff7a00; }
  .blue span { background: #00a7b7; }
  .pink span { background: #ec0057; }

  @media (max-width: 1150px) {
    .blend-shell {
      grid-template-columns: 1fr;
    }

    .blend-copy {
      text-align: center;
    }

    .blend-copy p,
    .blend-points {
      margin-left: auto;
      margin-right: auto;
    }

    .blend-actions {
      justify-content: center;
    }
  }

  @media (max-width: 700px) {
    .blend-spotlight {
      padding: 80px 20px;
    }

    .blend-cards {
      grid-template-columns: 1fr;
    }

    .blend-points {
      grid-template-columns: 1fr;
    }

    .blend-copy h2 {
      font-size: 58px;
      letter-spacing: -2px;
    }

    .blend-copy p {
      font-size: 18px;
    }
  }
</style>

{% schema %}
{
  "name": "TropiOasis Custom Blend",
  "settings": [],
  "presets": [
    {
      "name": "TropiOasis Custom Blend"
    }
  ]
}
{% endschema %}